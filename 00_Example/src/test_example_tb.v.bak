`timescale 1ns/1ps

module test_example_tb;

    // Testbench signals
    reg  [9:0] SW;
    wire [7:0] HEX0;
    wire [7:0] HEX1;
    wire [7:0] HEX2;
    wire [7:0] HEX3;
    wire [7:0] HEX4;
    wire [7:0] HEX5;

    // Instantiate the DUT (Device Under Test)
    test_example DUT (
        .SW(SW),
        .HEX0(HEX0),
        .HEX1(HEX1),
        .HEX2(HEX2),
        .HEX3(HEX3),
        .HEX4(HEX4),
        .HEX5(HEX5)
    );

    // Test stimulus
    initial begin

        // Initialize
        SW = 10'b0;

        #10;
        SW[3:0] = 4'h0;   // HEX0 should display 0
        SW[7:4] = 4'h1;   // HEX1 should display 1

        #10;
        SW[3:0] = 4'h5;   // HEX0 = 5
        SW[7:4] = 4'hA;   // HEX1 = A

        #10;
        SW[3:0] = 4'hF;   // HEX0 = F
        SW[7:4] = 4'hC;   // HEX1 = C

        #10;
        SW[3:0] = 4'h2;   // HEX0 = 2
        SW[7:4] = 4'h9;   // HEX1 = 9

        #10;

        $finish;
    end

endmodule
