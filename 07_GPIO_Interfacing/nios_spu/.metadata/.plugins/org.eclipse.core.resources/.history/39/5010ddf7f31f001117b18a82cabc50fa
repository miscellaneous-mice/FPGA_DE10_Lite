#include <stdio.h>
#include <stdint.h>
#include <unistd.h>
#include "system.h"
#include "io.h"
#include "altera_msgdma.h"
#include "altera_msgdma_descriptor_regs.h"

#define UNCACHED(addr) ((void*)((uint32_t)(addr) | 0x80000000))

// Force 32-byte alignment for DMA safety
static volatile uint32_t key_buf __attribute__ ((aligned (32))) = 0;
static volatile uint32_t sw_buf  __attribute__ ((aligned (32))) = 0;

int main() {
    alt_msgdma_dev *dma = alt_msgdma_open(DMA_IO_CSR_NAME);
    alt_msgdma_standard_descriptor desc;

    printf("--- DMA Switch Capture System ---\n");

    while(1) {
        // 1. Read Key (Source: Peripheral -> Dest: SDRAM)
        alt_msgdma_construct_standard_mm_to_mm_descriptor(
            dma, &desc,
            (uint32_t *)IO_MODULES_AVALON_KEY_PIO_BASE,
            (uint32_t *)&key_buf,
            4, // 1 Word
            0  // Remove PARK for now to simplify
        );

        // Check if the transfer actually succeeded
        if (alt_msgdma_standard_descriptor_sync_transfer(dma, &desc) != 0) {
            // If we get here, the DMA is stuck.
            // This usually means the Qsys bridge or slave didn't respond.
            continue;
        }

        uint32_t k = IORD_32DIRECT(UNCACHED(&key_buf), 0);

        if (k & 0x01) {
            printf("KEY0 Trigger! Capturing Switches...\n");

            // 2. Read Switches
            alt_msgdma_construct_standard_mm_to_mm_descriptor(
                dma, &desc,
                (uint32_t *)IO_MODULES_AVALON_SW_PIO_BASE,
                (uint32_t *)&sw_buf,
                4,
                0
            );

            if (alt_msgdma_standard_descriptor_sync_transfer(dma, &desc) == 0) {
                uint32_t s = IORD_32DIRECT(UNCACHED(&sw_buf), 0);
                printf("SUCCESS: Switches = 0x%03X\n", (unsigned int)(s & 0x3FF));
            } else {
                printf("ERROR: Switch DMA timed out!\n");
            }
            usleep(250000); // Debounce
        }
        usleep(10000);
    }
    return 0;
}
