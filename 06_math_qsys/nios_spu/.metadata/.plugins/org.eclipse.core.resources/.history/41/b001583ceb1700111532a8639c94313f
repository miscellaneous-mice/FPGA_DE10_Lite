#include <stdio.h>
#include <stdint.h>
#include <unistd.h>
#include "system.h"
#include "io.h"
#include "sys/alt_flash.h"       // Required for Flash API
#include "sys/alt_flash_dev.h"

void flash_interfacing()
{
    printf("Starting MAX 10 On-Chip Flash Test...\n");

    // 1. Open the Flash Device
    // The name comes from system.h, usually "/dev/onchip_flash_0"
    alt_flash_fd* flash_handle;
    flash_handle = alt_flash_open_dev(ONCHIP_FLASH_0_NAME);

    if (flash_handle == NULL) {
        printf("Error: Could not open flash device.\n");
        return 1;
    }
    printf("Flash opened successfully!\n");

    // 2. Prepare data to write
    char write_data[64] = "Hello Flash! This data survives power loss.";
    char read_data[64]  = {0}; // Empty buffer for reading
    int flash_offset = 0;      // Write to the very beginning of UFM1

    // 3. Write to Flash
    // alt_write_flash automatically erases the sector, then writes the data.
    printf("Writing to Flash...\n");
    int write_result = alt_write_flash(
        flash_handle,
        flash_offset,
        write_data,
        strlen(write_data) + 1 // +1 to include the null terminator
    );

    if (write_result == 0) {
        printf("Write successful!\n");
    } else {
        printf("Write failed!\n");
    }

    // 4. Read from Flash
    // We use the API to read it back into our empty read_data buffer
    printf("Reading from Flash...\n");
    int read_result = alt_read_flash(
        flash_handle,
        flash_offset,
        read_data,
        strlen(write_data) + 1
    );

    if (read_result == 0) {
        printf("Data read from Flash: '%s'\n", read_data);
    } else {
        printf("Read failed!\n");
    }

    // 5. Close the device
    alt_flash_close_dev(flash_handle);

    printf("Test complete.\n");
}

int main()
{
    printf("Starting Switch to Hex Display program...\n");

    // Variables to hold our hardware states
    uint32_t switch_value = 0;
    uint32_t last_switch_value = 0xFFFFFFFF; // Set to invalid value initially

    // Infinite loop to read hardware in real-time
    while (1)
    {
        /*
         * 1. READ FROM SWITCHES
         * We use IORD_32DIRECT to read directly from the base address
         * defined in your system.h file. Offset is 0.
         */
        switch_value = IORD_32DIRECT(IO_INTERFACE_SWITCH_INTERFACE_BASE, 0);

        /*
         * 2. WRITE TO 7-SEGMENT DISPLAY
         * We use IOWR_32DIRECT to write the switch value directly to the
         * hex display base address.
         */
        IOWR_32DIRECT(IO_INTERFACE_HEX_DISPLAY_BASE, 0, switch_value);

        /*
         * 3. PRINT TO CONSOLE (Only if the value changed)
         * Printing every loop is too fast and will lag the JTAG UART.
         * We only print when we detect the user flipped a switch.
         */
        if (switch_value != last_switch_value)
        {
            // Print both decimal and hexadecimal representations
            printf("Switches changed! Value: %lu (0x%03lX)\n", switch_value, switch_value);

            // Update last known state
            last_switch_value = switch_value;
        }

        /*
         * 4. SMALL DELAY
         * Optional: A small 10ms delay to prevent the CPU from
         * looping millions of times a second unnecessarily.
         */
        usleep(10000);
    }

    return 0;
}
