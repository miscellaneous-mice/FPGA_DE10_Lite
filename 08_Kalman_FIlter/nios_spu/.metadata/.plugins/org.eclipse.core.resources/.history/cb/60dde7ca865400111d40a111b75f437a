#include <stdio.h>
#include <math.h>
#include "system.h"
#include "io.h"

#define Q_SHIFT 18
#define FLOAT_TO_FIXED(x) ((signed int)((x) * (1 << Q_SHIFT)))
#define FIXED_TO_FLOAT(x) ((float)(x) / (float)(1 << Q_SHIFT))

#define REG_VALPHA    (0  * 4)
#define REG_VBETA     (1  * 4)
#define REG_IALPHAM   (2  * 4)
#define REG_IBETAM    (3  * 4)
#define REG_NBSAMPLES (6  * 4)
#define REG_OMEGA     (7  * 4)
#define REG_THETA     (8  * 4)
#define REG_K00       (11 * 4)

int main() {
    printf("Starting Physically Accurate Kalman Filter Test...\n");

    // Let the FPGA run continuously without long wait states
    IOWR_32DIRECT(KALMAN_BASE, REG_NBSAMPLES, 100);

    float t = 0.0;
    float Ts = 0.00001; // MUST match Verilog parameter Ts = 0.00001
    int loop_counter = 0;

    // Simulated motor parameters matching your Verilog:
    float simulated_omega = 100.0; // rad/s
    float v_amplitude = 40.0;      // Volts
    float i_amplitude = 7.68;      // Amps (calculated for your Rs and Ls at 100rad/s)
    float phase_delay = 0.96;      // Radians (calculated Z angle)

    while (1) {
        // 1. Generate perfect physical sine waves
        float v_alpha = v_amplitude * cos(simulated_omega * t);
        float v_beta  = v_amplitude * sin(simulated_omega * t);

        float i_alpha = i_amplitude * cos(simulated_omega * t - phase_delay);
        float i_beta  = i_amplitude * sin(simulated_omega * t - phase_delay);

        // 2. Write to FPGA
        IOWR_32DIRECT(KALMAN_BASE, REG_VALPHA,  FLOAT_TO_FIXED(v_alpha));
        IOWR_32DIRECT(KALMAN_BASE, REG_VBETA,   FLOAT_TO_FIXED(v_beta));
        IOWR_32DIRECT(KALMAN_BASE, REG_IALPHAM, FLOAT_TO_FIXED(i_alpha));
        IOWR_32DIRECT(KALMAN_BASE, REG_IBETAM,  FLOAT_TO_FIXED(i_beta));

        // 3. Read from FPGA
        float omega_out = FIXED_TO_FLOAT(IORD_32DIRECT(KALMAN_BASE, REG_OMEGA));
        float theta_out = FIXED_TO_FLOAT(IORD_32DIRECT(KALMAN_BASE, REG_THETA));

        // 4. Print only once every 5000 loops to simulate an oscilloscope view
        if (loop_counter % 5000 == 0) {
            printf("Time: %6.4f s | Om_Target: 100.0 | Est_Omega: %8.2f rad/s | Est_Theta: %8.2f rad\n",
                   t, omega_out, theta_out);
        }

        // Advance time by exactly Verilog Ts
        t += Ts;
        loop_counter++;
    }

    return 0;
}
