#include <stdio.h>
#include <math.h>
#include "system.h"
#include "io.h"
#include <unistd.h>

#define Q_SHIFT 18
#define FLOAT_TO_FIXED(x) ((signed int)((x) * (1 << Q_SHIFT)))
#define FIXED_TO_FLOAT(x) ((float)(x) / (float)(1 << Q_SHIFT))

#define REG_VALPHA    (0  * 4)
#define REG_VBETA     (1  * 4)
#define REG_IALPHAM   (2  * 4)
#define REG_IBETAM    (3  * 4)
#define REG_NBSAMPLES (6  * 4)
#define REG_OMEGA     (7  * 4)
#define REG_THETA     (8  * 4)

int main() {
    printf("Starting Stable Architecture Test...\n");

    // 1. ELIMINATE THE RACE CONDITION
    // Set nbSamples to 10. The FPGA state machine takes ~80 cycles to do the math.
    // 80 + 10 = 90 cycles. At 50MHz, the FPGA will finish in 1.8 microseconds.
    IOWR_32DIRECT(KALMAN_BASE, REG_NBSAMPLES, 10);

    float Rs = 1.477;
    float Ls = 0.0211;
    float Lambda = 0.2026;
    float Ts = 0.00001;

    // ========================================================
    // TEST 1: THE ZERO-STATE TEST
    // ========================================================
    printf("\n--- TEST 1: ZERO STATE ---\n");
    printf("If these numbers blow up, the Q22 parameter in Verilog is too large.\n");
    for (int i = 0; i < 5; i++) {
        IOWR_32DIRECT(KALMAN_BASE, REG_VALPHA,  0);
        IOWR_32DIRECT(KALMAN_BASE, REG_VBETA,   0);
        IOWR_32DIRECT(KALMAN_BASE, REG_IALPHAM, 0);
        IOWR_32DIRECT(KALMAN_BASE, REG_IBETAM,  0);

        usleep(100); // 100us is plenty of time for 1.8us FPGA calculation

        float out_om = FIXED_TO_FLOAT(IORD_32DIRECT(KALMAN_BASE, REG_OMEGA));
        printf("Zero Test Loop %d | Est_Omega: %8.2f rad/s\n", i, out_om);
    }

    // ========================================================
    // TEST 2: THE LOW-AMPLITUDE TRACKING TEST
    // ========================================================
    printf("\n--- TEST 2: LOW AMPLITUDE PHYSICS ---\n");
    float sim_ialpha = 0.0;
    float sim_ibeta  = 0.0;
    float sim_theta  = 0.0;
    float target_omega = 5.0; // Very slow speed to prevent internal overflow

    for (int i = 0; i < 50; i++) {
        // Apply a very small driving voltage (0.5V)
        float valpha = 0.5 * cos(sim_theta);
        float vbeta  = 0.5 * sin(sim_theta);

        // Calculate Physics
        float di_alpha = (valpha - (Rs * sim_ialpha) + (Lambda * target_omega * sin(sim_theta))) / Ls;
        float di_beta  = (vbeta  - (Rs * sim_ibeta)  - (Lambda * target_omega * cos(sim_theta))) / Ls;

        sim_ialpha += di_alpha * Ts;
        sim_ibeta  += di_beta * Ts;
        sim_theta  += target_omega * Ts;

        // Keep angle constrained
        if (sim_theta > 3.14159) sim_theta -= 2.0 * 3.14159;
        if (sim_theta < -3.14159) sim_theta += 2.0 * 3.14159;

        // Write to FPGA
        IOWR_32DIRECT(KALMAN_BASE, REG_VALPHA,  FLOAT_TO_FIXED(valpha));
        IOWR_32DIRECT(KALMAN_BASE, REG_VBETA,   FLOAT_TO_FIXED(vbeta));
        IOWR_32DIRECT(KALMAN_BASE, REG_IALPHAM, FLOAT_TO_FIXED(sim_ialpha));
        IOWR_32DIRECT(KALMAN_BASE, REG_IBETAM,  FLOAT_TO_FIXED(sim_ibeta));

        usleep(100); // Wait for FPGA

        float log_omega = FIXED_TO_FLOAT(IORD_32DIRECT(KALMAN_BASE, REG_OMEGA));
        float log_theta = FIXED_TO_FLOAT(IORD_32DIRECT(KALMAN_BASE, REG_THETA));

        if (i % 10 == 0) {
            printf("Target Om: %5.1f | Est_Omega: %8.2f rad/s | Est_Theta: %8.2f rad\n",
                   target_omega, log_omega, log_theta);
        }
    }

    printf("\nTests Complete.\n");
    return 0;
}
