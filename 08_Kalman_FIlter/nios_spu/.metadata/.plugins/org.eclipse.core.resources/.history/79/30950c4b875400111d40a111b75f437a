#include <stdio.h>
#include <math.h>
#include "system.h"
#include "io.h"
#include <unistd.h>

#define Q_SHIFT 18
#define FLOAT_TO_FIXED(x) ((signed int)((x) * (1 << Q_SHIFT)))
#define FIXED_TO_FLOAT(x) ((float)(x) / (float)(1 << Q_SHIFT))

#define REG_VALPHA    (0  * 4)
#define REG_VBETA     (1  * 4)
#define REG_IALPHAM   (2  * 4)
#define REG_IBETAM    (3  * 4)
#define REG_NBSAMPLES (6  * 4)
#define REG_OMEGA     (7  * 4)
#define REG_THETA     (8  * 4)

#define LOG_SIZE 1000
float log_time[LOG_SIZE];
float log_omega[LOG_SIZE];
float log_theta[LOG_SIZE];

int main() {
    printf("Starting Perfect Physics Kalman Filter Test...\n");

    IOWR_32DIRECT(KALMAN_BASE, REG_NBSAMPLES, 50000);

    // Motor Parameters EXACTLY matching your Verilog code
    float Rs = 1.477;
    float Ls = 0.0211;
    float Lambda = 0.2026;
    float Ts = 0.00001;

    // True physical states of our simulated motor
    float sim_ialpha = 0.0;
    float sim_ibeta  = 0.0;
    float sim_theta  = 0.0;
    float target_omega = 0.0;
    float t = 0.0;

    printf("Running hardware simulation...\n");

    for (int i = 0; i < LOG_SIZE; i++) {

        // 1. Smoothly ramp up the target speed to 50 rad/s
        if (target_omega < 50.0) {
            target_omega += 0.05;
        }

        // 2. Apply a realistic driving voltage (e.g., 20V amplitude)
        float valpha = 20.0 * cos(sim_theta);
        float vbeta  = 20.0 * sin(sim_theta);

        // 3. PERFECT PHYSICS INTEGRATION: Calculate what the real current would be
        float di_alpha = (valpha - (Rs * sim_ialpha) + (Lambda * target_omega * sin(sim_theta))) / Ls;
        float di_beta  = (vbeta  - (Rs * sim_ibeta)  - (Lambda * target_omega * cos(sim_theta))) / Ls;

        // Update the simulated motor states
        sim_ialpha += di_alpha * Ts;
        sim_ibeta  += di_beta * Ts;
        sim_theta  += target_omega * Ts;

        // Wrap theta to keep it between -PI and PI (optional, but good practice)
        if (sim_theta > 3.14159) sim_theta -= 2.0 * 3.14159;
        if (sim_theta < -3.14159) sim_theta += 2.0 * 3.14159;

        // 4. Send this PERFECT data to the FPGA
        IOWR_32DIRECT(KALMAN_BASE, REG_VALPHA,  FLOAT_TO_FIXED(valpha));
        IOWR_32DIRECT(KALMAN_BASE, REG_VBETA,   FLOAT_TO_FIXED(vbeta));
        IOWR_32DIRECT(KALMAN_BASE, REG_IALPHAM, FLOAT_TO_FIXED(sim_ialpha));
        IOWR_32DIRECT(KALMAN_BASE, REG_IBETAM,  FLOAT_TO_FIXED(sim_ibeta));

        usleep(100); // Let FPGA calculate

        // 5. Read estimations from FPGA
        log_omega[i] = FIXED_TO_FLOAT(IORD_32DIRECT(KALMAN_BASE, REG_OMEGA));
        log_theta[i] = FIXED_TO_FLOAT(IORD_32DIRECT(KALMAN_BASE, REG_THETA));
        log_time[i]  = t;

        t += Ts;
    }

    printf("Hardware run complete! Printing results:\n");
    printf("----------------------------------------------------\n");

    // Print every 20th sample
    for (int i = 0; i < LOG_SIZE; i += 20) {
        printf("Time: %.5f s | Target Om: %5.1f | Est_Omega: %8.2f rad/s | Est_Theta: %8.2f rad\n",
               log_time[i], (i * 0.05), log_omega[i], log_theta[i]);
    }

    printf("Test finished successfully.\n");
    return 0;
}
