#include <stdio.h>
#include <math.h>     // For sin() and cos()
#include "system.h"
#include "io.h"
#include <unistd.h>

// Define the Q-format from your Verilog (Q18)
#define Q_SHIFT 18
#define FLOAT_TO_FIXED(x) ((signed int)((x) * (1 << Q_SHIFT)))
#define FIXED_TO_FLOAT(x) ((float)(x) / (float)(1 << Q_SHIFT))

// Register Offsets
#define REG_VALPHA    (0  * 4)
#define REG_VBETA     (1  * 4)
#define REG_IALPHAM   (2  * 4)
#define REG_IBETAM    (3  * 4)
#define REG_CTHETA_T  (4  * 4)
#define REG_STHETA_T  (5  * 4)
#define REG_NBSAMPLES (6  * 4)

#define REG_OMEGA     (7  * 4)
#define REG_THETA     (8  * 4)
#define REG_IALPHAK   (9  * 4)
#define REG_IBETAK    (10 * 4)
#define REG_K00       (11 * 4)

int main() {
    printf("Starting Dynamic Kalman Filter Test...\n");

    // Set nbSamples to match Verilog Ts = 0.00001 (10us)
    // If FPGA clock is 50MHz, 50MHz * 10us = 500 clock cycles
    int samples = 500;
    IOWR_32DIRECT(KALMAN_BASE, REG_NBSAMPLES, samples);

    float t = 0.0;
    float simulated_omega = 314.15; // ~50 Hz electrical frequency (rad/s)

    while (1) {
        // 1. Simulate motor currents and voltages (3-phase mapped to alpha/beta)
        float v_alpha = 10.0 * cos(simulated_omega * t);
        float v_beta  = 10.0 * sin(simulated_omega * t);

        // Current usually lags voltage in a motor (inductive load)
        float i_alpha = 2.5 * cos(simulated_omega * t - 0.5);
        float i_beta  = 2.5 * sin(simulated_omega * t - 0.5);

        // 2. Write Inputs to the Kalman IP
        IOWR_32DIRECT(KALMAN_BASE, REG_VALPHA,  FLOAT_TO_FIXED(v_alpha));
        IOWR_32DIRECT(KALMAN_BASE, REG_VBETA,   FLOAT_TO_FIXED(v_beta));
        IOWR_32DIRECT(KALMAN_BASE, REG_IALPHAM, FLOAT_TO_FIXED(i_alpha));
        IOWR_32DIRECT(KALMAN_BASE, REG_IBETAM,  FLOAT_TO_FIXED(i_beta));

        // 3. Read Outputs from the Kalman IP
        float omega_out = FIXED_TO_FLOAT(IORD_32DIRECT(KALMAN_BASE, REG_OMEGA));
        float theta_out = FIXED_TO_FLOAT(IORD_32DIRECT(KALMAN_BASE, REG_THETA));
        float k00_out   = FIXED_TO_FLOAT(IORD_32DIRECT(KALMAN_BASE, REG_K00));

        // 4. Print Results
        printf("Time: %.3f s | V_alpha: %6.2f | Est_Omega: %8.2f rad/s | Est_Theta: %8.2f rad | K00: %6.4f\n",
               t, v_alpha, omega_out, theta_out, k00_out);

        // Advance time by 1ms per loop for the simulation
        t += 0.001;

        // Sleep for 100ms so the serial terminal doesn't flood too fast
        usleep(100000);
    }

    return 0;
}
