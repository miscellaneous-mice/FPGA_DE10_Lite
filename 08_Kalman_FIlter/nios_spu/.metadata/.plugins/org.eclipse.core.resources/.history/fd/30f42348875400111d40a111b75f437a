#include <stdio.h>
#include <math.h>
#include "system.h"
#include "io.h"
#include <unistd.h>

#define Q_SHIFT 18
#define FLOAT_TO_FIXED(x) ((signed int)((x) * (1 << Q_SHIFT)))
#define FIXED_TO_FLOAT(x) ((float)(x) / (float)(1 << Q_SHIFT))

#define REG_VALPHA    (0  * 4)
#define REG_VBETA     (1  * 4)
#define REG_IALPHAM   (2  * 4)
#define REG_IBETAM    (3  * 4)
#define REG_NBSAMPLES (6  * 4)
#define REG_OMEGA     (7  * 4)
#define REG_THETA     (8  * 4)

#define LOG_SIZE 1000
float log_time[LOG_SIZE];
float log_omega[LOG_SIZE];
float log_theta[LOG_SIZE];

int main() {
    printf("Starting Soft-Start Kalman Filter Test...\n");

    IOWR_32DIRECT(KALMAN_BASE, REG_NBSAMPLES, 50000);

    float t = 0.0;
    float Ts = 0.00001;

    // Start everything at ZERO to match the FPGA reset state
    float current_omega = 0.0;
    float v_amp = 0.0;
    float i_amp = 0.0;

    float theta_sim = 0.0; // We must integrate angle manually during a ramp
    float phase_delay = 0.5;

    printf("Running hardware simulation...\n");

    for (int i = 0; i < LOG_SIZE; i++) {

        // 1. RAMP UP THE MOTOR GRADUALLY (Soft Start)
        // Reaches 50 rad/s, 2.0V, and 0.5A by the end of the 1000 loops
        if (current_omega < 50.0) current_omega += 0.05;
        if (v_amp < 2.0) v_amp += 0.002;
        if (i_amp < 0.5) i_amp += 0.0005;

        // 2. Calculate the true physical angle
        theta_sim += current_omega * Ts;

        // 3. Generate sine waves using the soft-started values
        float v_alpha = v_amp * cos(theta_sim);
        float v_beta  = v_amp * sin(theta_sim);
        float i_alpha = i_amp * cos(theta_sim - phase_delay);
        float i_beta  = i_amp * sin(theta_sim - phase_delay);

        // 4. Write to FPGA
        IOWR_32DIRECT(KALMAN_BASE, REG_VALPHA,  FLOAT_TO_FIXED(v_alpha));
        IOWR_32DIRECT(KALMAN_BASE, REG_VBETA,   FLOAT_TO_FIXED(v_beta));
        IOWR_32DIRECT(KALMAN_BASE, REG_IALPHAM, FLOAT_TO_FIXED(i_alpha));
        IOWR_32DIRECT(KALMAN_BASE, REG_IBETAM,  FLOAT_TO_FIXED(i_beta));

        usleep(100);

        // 5. Read from FPGA
        log_omega[i] = FIXED_TO_FLOAT(IORD_32DIRECT(KALMAN_BASE, REG_OMEGA));
        log_theta[i] = FIXED_TO_FLOAT(IORD_32DIRECT(KALMAN_BASE, REG_THETA));
        log_time[i]  = t;

        t += Ts;
    }

    printf("Hardware run complete! Printing results:\n");
    printf("----------------------------------------------------\n");

    // Print every 20th sample
    for (int i = 0; i < LOG_SIZE; i += 20) {
        printf("Time: %.5f s | Target Om: %5.1f | Est_Omega: %8.2f rad/s | Est_Theta: %8.2f rad\n",
               log_time[i], (i * 0.05), log_omega[i], log_theta[i]);
    }

    printf("Test finished successfully.\n");
    return 0;
}
