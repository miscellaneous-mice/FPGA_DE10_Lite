transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vlog -vlog01compat -work work +incdir+C:/Sandbox/FPGA/08_Kalman_FIlter/Testing/src {C:/Sandbox/FPGA/08_Kalman_FIlter/Testing/src/state_update.v}
vlog -vlog01compat -work work +incdir+C:/Sandbox/FPGA/08_Kalman_FIlter/Testing/src {C:/Sandbox/FPGA/08_Kalman_FIlter/Testing/src/mult.v}
vlog -vlog01compat -work work +incdir+C:/Sandbox/FPGA/08_Kalman_FIlter/Testing/src {C:/Sandbox/FPGA/08_Kalman_FIlter/Testing/src/matrix_multiplication.v}
vlog -vlog01compat -work work +incdir+C:/Sandbox/FPGA/08_Kalman_FIlter/Testing/src {C:/Sandbox/FPGA/08_Kalman_FIlter/Testing/src/kalman.v}
vlog -vlog01compat -work work +incdir+C:/Sandbox/FPGA/08_Kalman_FIlter/Testing/src {C:/Sandbox/FPGA/08_Kalman_FIlter/Testing/src/fixedpoint_multiplier.v}
vlog -vlog01compat -work work +incdir+C:/Sandbox/FPGA/08_Kalman_FIlter/Testing/src {C:/Sandbox/FPGA/08_Kalman_FIlter/Testing/src/div2.v}
vlog -vlog01compat -work work +incdir+C:/Sandbox/FPGA/08_Kalman_FIlter/Testing/src {C:/Sandbox/FPGA/08_Kalman_FIlter/Testing/src/cordic.v}

vlog -vlog01compat -work work +incdir+C:/Sandbox/FPGA/08_Kalman_FIlter/Testing/simulation {C:/Sandbox/FPGA/08_Kalman_FIlter/Testing/simulation/div2_tb.v}

vsim -t 1ps -L altera_ver -L lpm_ver -L sgate_ver -L altera_mf_ver -L altera_lnsim_ver -L fiftyfivenm_ver -L rtl_work -L work -voptargs="+acc"  div2_tb

add wave *
view structure
view signals
run -all
